{
  "name": "bookontime",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "build": "npm run typecheck && vite build",
    "preview": "vite preview --host 127.0.0.1",
    "holidays": "node scripts/generate-holidays.ts",
    "assets": "node scripts/prepare-assets.ts",
    "verify:build": "node scripts/verify-build.ts",
    "format": "prettier --write src tests scripts/*.ts *.ts",
    "format:check": "prettier --check src tests scripts/*.ts *.ts"
  },
  "dependencies": {
    "@fontsource-variable/inter": "^5.3.0",
    "@js-temporal/polyfill": "^0.5.1",
    "idb": "^8.0.3",
    "lucide-react": "^1.45.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "zod": "^4.6.2"
  },
  "devDependencies": {
    "@types/node": "^22.20.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "date-holidays": "^3.36.1",
    "fake-indexeddb": "^6.2.5",
    "prettier": "^3.9.6",
    "sharp": "^0.35.4",
    "typescript": "^7.0.2",
    "vite": "^8.3.0",
    "vite-plugin-pwa": "^1.3.0",
    "vitest": "^5.0.0"
  },
  "engines": {
    "node": ">=24.0.0"
  }
}
